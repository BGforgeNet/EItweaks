 #include <thread>
 #include <mutex>
 #include <atomic>
@@ -225,10 +227,17 @@ static ValueType ClassifyValue(const std::string& s, int32_t& outInt, float& out
 /**
  * Formats a 32-bit float matching Evil Islands compact representation.
  */
+// Shortest text that parses back to the same float, always with a '.' or exponent: without one,
+// ini2reg reads "3" as an integer and a list such as "1" and "0.33" as strings.
 static std::string FormatFloat(float val) {
     char buf[64];
-    snprintf(buf, sizeof(buf), "%.6g", val);
-    return std::string(buf);
+    for (int precision = 6; precision <= 9; ++precision) {
+        snprintf(buf, sizeof(buf), "%.*g", precision, val);
+        if (std::isnan(val) || std::isinf(val) || std::strtof(buf, nullptr) == val) break;
+    }
+    std::string s(buf);
+    if (std::isfinite(val) && s.find_first_of(".eE") == std::string::npos) s += ".0";
+    return s;
 }
 
