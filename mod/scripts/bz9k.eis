Script #OnBriefingComplete
(
  if
  (
    IsEqualString( szComplete, "b.bz9k.Yc45" ) 
  )
  then
  (
    KillScript(  ) 
  )
  if
  (
    IsEqualString( szComplete, "b.bz9k.Yc46" ) 
  )
  then
  (
    KillScript(  ) 
  )
  if
  (
    IsEqualString( szComplete, "b.YCF.Yc47_2" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVarMax( 0, "b.YCF.Yc47", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.YCF.Yc47" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVarMax( 0, "amerc_9", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc9.n1_9" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc9", 1 ) 
    MoveToPoint( GetObjectByName( "merc9" ) , 67, 58.3 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    RotateTo( GetObjectByName( "merc9" ) , 70, 53 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    GSSetVar( 0, "apartyn9", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc9.n2_9" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc9", 0 ) 
    MoveToPoint( GetObjectByName( "merc9" ) , 73.3, 51.8 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    RotateTo( GetObjectByName( "merc9" ) , 69, 52 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    GSSetVar( 0, "apartyn9", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc9.n3_9" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc9", 1 ) 
    MoveToPoint( GetObjectByName( "merc9" ) , 67, 58.3 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    RotateTo( GetObjectByName( "merc9" ) , 70, 53 ) 
    SleepUntilIdle( GetObjectByName( "merc9" )  ) 
    GSSetVar( 0, "apartyn9", 1 ) 
  )
  if
  (
  )
  then
  (
    KillScript(  ) 
  )
)

