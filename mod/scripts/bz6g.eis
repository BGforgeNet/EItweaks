Script #OnBriefingComplete
(
  if
  (
    IsEqualString( szComplete, "b.OrcC.Sh40" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVarMax( 0, "PeaceSv", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc4.n1_4" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc4", 1 ) 
    MoveToPoint( GetObjectByName( "merc4" ) , 67, 68 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    RotateTo( GetObjectByName( "merc4" ) , 70.7, 62.7 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    GSSetVar( 0, "apartyn4", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc4.n2_4" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc4", 0 ) 
    MoveToPoint( GetObjectByName( "merc4" ) , 74.7, 58.1 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    RotateTo( GetObjectByName( "merc4" ) , 72.7, 62.45 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    GSSetVar( 0, "apartyn4", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.merc4.n3_4" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVar( 0, "ctravel.merc4", 1 ) 
    MoveToPoint( GetObjectByName( "merc4" ) , 67, 68 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    RotateTo( GetObjectByName( "merc4" ) , 70.7, 62.7 ) 
    SleepUntilIdle( GetObjectByName( "merc4" )  ) 
    GSSetVar( 0, "apartyn4", 1 ) 
  )
  if
  (
  )
  then
  (
    KillScript(  ) 
  )
)

