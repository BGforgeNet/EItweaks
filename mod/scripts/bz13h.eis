Script #OnBriefingComplete
(
  if
  (
    IsEqualString( szComplete, "b.bz13h.Hns59" ) 
  )
  then
  (
    KillScript(  ) 
    GSSetVarMax( 0, "z.gz15h", 1 ) 
    LeaveToZone( 0, "gz15h", 1 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.Nalo.Kr61" ) 
  )
  then
  (
    KillScript(  ) 
    CopyStats( 0, "HeroAlone::Hero", "Hero" ) 
    AddLoot( 0, "HeroAlone", "" ) 
    SetCurrentParty( 0, "" ) 
    FixItems(  ) 
    RunWorldTime( 0 ) 
    LeaveToZone( 0, "gz15h", 3 ) 
  )
  if
  (
    IsEqualString( szComplete, "b.Nalo.Kr60" ) 
  )
  then
  (
    KillScript(  ) 
    CreateParty( 0, "Pretty" ) 
    AddUnitToParty( 0, "Pretty::Nalo", "Human Hadagan Pretty" ) 
    SetCurrentParty( 0, "Pretty" ) 
    LeaveToZone( 0, "gz15h", 3 ) 
  )
  if
  (
  )
  then
  (
    KillScript(  ) 
  )
)

