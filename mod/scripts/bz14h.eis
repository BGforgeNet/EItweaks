// Companions travel (eitweaks.ini): a mercenary from Gipath or Ingos in the party can be left here and taken back.
// The game offers the leave briefing only in the mercenary's own base and clears it at every merc briefing,
// so this script offers it again on every pass. ctravel.mercN is 1 while the mercenary is in the party.
Script CTravelOffers
(
  if
  (
    Not( IsEqual( GSGetVar( 0, "ini.eitweaks.Companions.Travel" ) , 1 )  ) 
  )
  then
  (
    KillScript(  ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc1" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc1.n2_1", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc2" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc2.n2_2", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc3" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc3.n2_3", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc4" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc4.n2_4", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc5" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc5.n2_5", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc6" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc6.n2_6", 1 ) 
  )
  if
  (
    IsEqual( GSGetVar( 0, "ctravel.merc9" ) , 1 ) 
  )
  then
  (
    GSSetVarMax( 0, "b.merc9.n2_9", 1 ) 
  )
)

